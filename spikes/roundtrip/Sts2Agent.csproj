<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sts2Agent</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <GameDataDir>$(Sts2Dir)/data_sts2_linuxbsd_x86_64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDataDir)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)/0Harmony.dll" Private="false" />
    <Reference Include="SmartFormat" HintPath="$(GameDataDir)/SmartFormat.dll" Private="false" />
    <None Include="Sts2Agent.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="Set Sts2Dir to the Linux game installation directory." />
  </Target>
</Project>
